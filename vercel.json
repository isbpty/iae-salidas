{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "includeFiles": "server/**", "maxDuration": 15 } },
  "rewrites": [
    { "source": "/super", "destination": "/super.html" },
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] },
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] },
    { "source": "/client/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/index.html", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/super", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/super.html", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/super-sw.js", "headers": [
      { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
      { "key": "Service-Worker-Allowed", "value": "/" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/super-manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/icons/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=86400" }
    ] }
  ]
}
